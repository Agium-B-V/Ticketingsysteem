# Kopieer naar .env.local voor lokaal ontwikkelen. Zet hier nooit de service-role key.

# Project-URL van Supabase (Project Settings > API)
VITE_SUPABASE_URL=https://<project-ref>.supabase.co

# Publieke anon key (of publishable key). Deze komt per definitie in de bundle
# en is veilig zolang RLS goed staat.
VITE_SUPABASE_ANON_KEY=<anon-key>

# Base path van de app. GitHub Pages: /<repo-naam>/ ; Azure Static Web Apps of lokaal: /
VITE_BASE_PATH=/
